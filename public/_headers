# Cloudflare Pages response headers.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: blob: https://wtexrwkkijviptexvwmr.supabase.co; connect-src 'self' https://wtexrwkkijviptexvwmr.supabase.co wss://wtexrwkkijviptexvwmr.supabase.co https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; form-action 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

/img/*
  Cache-Control: public, max-age=2592000

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/admin
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

/admin.html
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
