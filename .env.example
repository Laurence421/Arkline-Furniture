# Browser (safe to expose; access is enforced by Row Level Security)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server only (Vercel → Project → Settings → Environment Variables). Never prefix with VITE_.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# New-quote email alerts via Resend (optional; requests are saved even without these)
RESEND_API_KEY=
NOTIFY_EMAIL=arklinehomeandofficefurnitures@gmail.com
NOTIFY_FROM=Arkline Website <quotes@your-verified-domain.com>
