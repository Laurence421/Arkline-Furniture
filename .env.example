# Browser (public by design; access is enforced by Row Level Security)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...
VITE_TURNSTILE_SITE_KEY=            # optional spam check (Cloudflare Turnstile)

# Server only. Never prefix with VITE_.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
TURNSTILE_SECRET_KEY=               # optional; set together with the site key

# New-quote email alerts via Resend (optional; requests are saved even without these).
# Free with no domain: sign up to Resend with NOTIFY_EMAIL, leave NOTIFY_FROM empty
# (it sends from onboarding@resend.dev, which can only reach that same address).
RESEND_API_KEY=
NOTIFY_EMAIL=arklinefurniture3@gmail.com
NOTIFY_FROM=
